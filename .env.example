# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# Shown in every footer as "Website preview by …"
NEXT_PUBLIC_AGENCY_NAME="Your Agency"
# Optional: makes the agency name a link
NEXT_PUBLIC_AGENCY_URL=""

# The public URL of this deployment (used for canonical URLs, Open Graph images and JSON-LD)
NEXT_PUBLIC_SITE_URL="https://your-previews.vercel.app"

# Previews of practices that aren't your clients yet are hidden from search engines by default.
# Set to "true" only once a practice has signed off and this becomes their real site.
NEXT_PUBLIC_INDEX_PREVIEWS="false"
